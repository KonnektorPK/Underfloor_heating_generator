<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <RootNamespace>Underfloor_heating_generator</RootNamespace>
    <AssemblyName>Underfloor_heating_generator</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>Build\</OutputPath>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2026\</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Underfloor_heating_generator.addin" CopyToOutputDirectory="Never" />
    <None Update="Resources\Icons\WarmFloor.png" CopyToOutputDirectory="Never" />
    <Resource Include="Resources\Icons\WarmFloor.ico" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="Build">
    <Delete Files="$(TargetDir)WarmFloor.png;$(TargetDir)WarmFloor.ico" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Underfloor_heating_generator.addin"
          DestinationFiles="$(TargetDir)Underfloor_heating_generator.addin" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\Icons\WarmFloor.png;$(MSBuildProjectDirectory)\Resources\Icons\WarmFloor.ico"
          DestinationFolder="$(TargetDir)icons" />
    <XmlPoke XmlInputPath="$(TargetDir)Underfloor_heating_generator.addin"
             Query="/RevitAddIns/AddIn/Assembly" Value="$(TargetPath)" />
  </Target>
</Project>
